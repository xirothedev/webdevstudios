{
  "name": "api",
  "version": "1.0.0",
  "description": "WebDev Studios E-commerce Platform - NestJS Backend API",
  "author": "Xiro The Dev <lethanhtrung.trungle@gmail.com>",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "build": "bunx --bun --no-install nest build",
    "postinstall": "bunx --bun --no-install prisma generate",
    "prisma:generate": "bunx --bun --no-install prisma generate",
    "prisma:migrate": "bunx --bun --no-install prisma migrate dev",
    "prisma:deploy": "bunx --bun --no-install prisma migrate deploy",
    "prisma:studio": "bunx --bun --no-install prisma studio",
    "prisma:seed": "bunx --bun --no-install prisma db seed",
    "prisma:seed:user": "bun prisma/user.seed.ts",
    "format": "bunx --bun --no-install prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bunx --bun --no-install nest start",
    "dev": "bunx --bun --no-install nest start --watch",
    "start:debug": "bunx --bun --no-install nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "lint": "bunx --bun --no-install oxlint --fix .",
    "test": "bun test ./src",
    "test:watch": "bun test --watch ./src",
    "test:cov": "bun test --coverage ./src ./test",
    "test:debug": "bun --inspect-brk test ./src",
    "test:e2e": "bun test ./test",
    "confirm-webhook": "./scripts/confirm-webhook.sh",
    "test-webhook": "./scripts/test-webhook.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@nestjs-modules/mailer": "^2.3.5",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "@payos/node": "^2.0.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@types/ua-parser-js": "^0.7.39",
    "argon2": "^0.44.0",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "date-fns": "^4.4.0",
    "express-basic-auth": "^1.2.1",
    "express-session": "^1.19.0",
    "ioredis": "^5.10.1",
    "ms": "^2.1.3",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "speakeasy": "^2.0.0",
    "ua-parser-js": "^2.0.9",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@types/bun": "^1.3.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
