# Copy to .env (same folder) and fill what you have. Every feature
# degrades gracefully when its block is empty.

PORT=4001

# Required
DATABASE_URL=postgresql://user:pass@localhost:5432/webdevstudios
JWT_SECRET_KEY=same-secret-as-nestjs-app

# Optional — enables email verification mail + avatar/blog uploads
MAIL_USER=
MAIL_PASS=
FRONTEND_URL=http://localhost:3000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=webdevstudios-storage
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com

REDIS_HOST=localhost
REDIS_PORT=6379
