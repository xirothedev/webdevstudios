// =========================================
// ENUMS (Define fixed value sets)
// =========================================

enum UserRole {
  ADMIN // Shop owner
  CUSTOMER // Customer
}

enum OrderStatus {
  PENDING // Awaiting payment
  CONFIRMED // Confirmed
  PROCESSING // Packaging
  SHIPPING // Shipping
  DELIVERED // Delivered successfully
  CANCELLED // Cancelled
  RETURNED // Returned
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE // Discount by percentage
  FIXED_AMOUNT // Fixed amount discount
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
  GITHUB
  APPLE
}

enum MFAMethod {
  TOTP // Time-based One-Time Password (Google Authenticator, Authy)
  SMS // SMS OTP
  EMAIL // Email OTP
  BACKUP_CODE // Backup codes
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// =========================================
// PRODUCT ENUMS
// =========================================

enum ProductSlug {
  AO_THUN // T-shirt WebDev Studios
  PAD_CHUOT // Mouse pad WebDev Studios
  DAY_DEO // Lanyard WebDev Studios
  MOC_KHOA // Keychain WebDev Studios
}

/**
 * Product size (only t-shirt has sizes)
 */
enum ProductSize {
  S
  M
  L
  XL
}

