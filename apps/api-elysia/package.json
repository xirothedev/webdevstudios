    "@prisma/client-runtime-utils": "^7.10.0",
    "argon2": "^0.45.1",
    "elysia": "^1.4.30",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "nodemailer": "^9.0.6",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0"
  }
}
