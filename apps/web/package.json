{
  "name": "web",
  "version": "1.0.0",
  "description": "WebDev Studios E-commerce Platform - Next.js Frontend",
  "author": "Xiro The Dev <lethanhtrung.trungle@gmail.com>",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' bunx --bun --no-install next dev --turbo",
    "build": "bunx --bun --no-install next build --webpack",
    "start": "bunx --bun --no-install next start",
    "lint": "bunx --bun --no-install eslint",
    "test": "bun test --pass-with-no-tests",
    "format": "bunx --bun --no-install prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "format:check": "bunx --bun --no-install prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "analyze": "bunx --bun --no-install next experimental-analyze",
    "debug": "bunx --bun --no-install next dev --inspect",
    "convert:png-to-webp": "bun scripts/convert-png-to-webp.ts",
    "convert:png-to-webp:delete": "bun scripts/convert-png-to-webp.ts --delete-original",
    "migrate:tailwind": "bunx --bun @tailwindcss/upgrade"
  },
  "reactDoctor": {
    "rules": {
      "react-doctor/no-giant-component": "off",
      "react-doctor/prefer-dynamic-import": "off"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.6",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@shikijs/rehype": "^4.1.0",
    "@tanstack/react-query": "^5.100.11",
    "@tiptap/extension-code-block": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/markdown": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.39.0",
    "next": "16.2.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.6",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
