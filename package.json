{
  "name": "webdevstudios-fullstack-turborepo",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Xiro The Dev <lethanhtrung.trungle@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/xirothedev/webdevstudios.git"
  },
  "homepage": "https://github.com/xirothedev/webdevstudios",
  "bugs": {
    "url": "https://github.com/xirothedev/webdevstudios/issues"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bunx --bun --no-install turbo run dev --parallel",
    "build": "bunx --bun --no-install turbo run build",
    "lint": "bunx --bun --no-install turbo run lint",
    "test": "bunx --bun --no-install turbo run test",
    "format": "bunx --bun --no-install prettier --write \"apps/api/**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\" \"*.{js,jsx,ts,tsx,json,md,yml,yaml}\" && cd apps/web && bun run format",
    "format:check": "bunx --bun --no-install prettier --check \"apps/api/**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\" \"*.{js,jsx,ts,tsx,json,md,yml,yaml}\" && cd apps/web && bun run format:check",
    "clean": "bunx --bun --no-install turbo run clean",
    "prepare": "bunx --bun --no-install husky",
    "audit": "bun audit --audit-level=moderate",
    "audit:fix": "bun update --latest && bun audit --audit-level=moderate",
    "outdated": "bun outdated --recursive",
    "lint:boundaries": "depcruise packages"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.14"
  },
  "trustedDependencies": [
    "@nestjs/core",
    "@prisma/engines",
    "@scarf/scarf",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "glob@>=10.2.0 <10.5.0": ">=10.5.0",
    "nodemailer@<7.0.11": ">=7.0.11",
    "nodemailer@<7.0.7": ">=7.0.7",
    "nodemailer@<=7.0.10": ">=7.0.11",
    "@nestjs-modules/mailer>mjml": "^5.0.0-alpha.4",
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.15"
  }
}
